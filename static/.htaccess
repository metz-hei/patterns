RewriteEngine On
RewriteBase /

# Block sensitive files and directory listing
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<FilesMatch "\.(sql|tsv)$">
  Require all denied
</FilesMatch>
<Files "gate.php">
  Require all denied
</Files>
<FilesMatch "^(router\.php|_bootstrap\.php)$">
  Require all denied
</FilesMatch>
Options -Indexes

# HTTPS
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule .* https://%{SERVER_NAME}%{REQUEST_URI} [R=301,L]

# API clean URLs
RewriteRule ^api/auth/login/?$ api/auth/login.php [L]
RewriteRule ^api/auth/logout/?$ api/auth/logout.php [L]
RewriteRule ^api/auth/session/?$ api/auth/session.php [L]
RewriteRule ^api/passwords/?$ api/passwords.php [L]
RewriteRule ^api/stats/?$ api/stats.php [L]

# Public login page
RewriteRule ^login/?$ login.html [L]

# Server-side auth gate for everything else
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_URI} !^/login(\.html)?/?$
RewriteRule ^ gate.php [L]
